# Copy to .env (outside the public web root) and fill in. Never commit .env.
APP_NAME="Fameweb NGO Cloud"
# production | staging | development | testing
APP_ENV=production
# Never true in production: debug output can reveal file paths and SQL.
APP_DEBUG=false
# Public URL without trailing slash, e.g. https://ngo.fameweb.in . Leave empty to auto-detect.
APP_URL=
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
# Encryption key for identity documents, SMTP passwords and queued email bodies.
# Generate with: php bin/generate-key.php   (keep a backup: encrypted files cannot be read without it)
APP_KEY=

# One-time secret the web installer asks for. Generate one with:
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# Remove or blank it after installation.
INSTALL_TOKEN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_NAME=fwngo_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=720
# auto | true | false  (use true once HTTPS is enforced)
SESSION_SECURE_COOKIE=auto

LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_IP=30
LOGIN_LOCKOUT_MINUTES=15
TRUST_PROXY_HEADERS=false

# log = write emails to storage/logs/mail.log ; mail = PHP mail() ; smtp = SMTP server below.
# These can also be set (and override .env) in Admin > Email > Settings.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Fameweb NGO Cloud"
# Hostinger email: smtp.hostinger.com, port 465 + ssl (or 587 + tls)
MAIL_HOST=
MAIL_PORT=465
# tls | ssl | none
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15

# Optional: absolute path of the writable storage folder (default: <app>/storage).
# STORAGE_PATH=
